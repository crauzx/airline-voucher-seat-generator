PORT=4000
DB_PATH=./data/vouchers.db

# Comma-separated browser origins allowed to call the API cross-origin.
# Defaults to http://localhost:5173,http://localhost:3000 when unset.
# Set to an empty value to disable CORS entirely (same-origin only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of proxy hops to trust for client IPs. Set to 1 behind the nginx container.
TRUST_PROXY=0

# Per-IP request budget applied to /api.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
